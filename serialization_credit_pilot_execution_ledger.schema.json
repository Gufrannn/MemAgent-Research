{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "serialization_credit_pilot_execution_ledger.schema.json",
  "title": "MemAgent 7B SMSB4/Tetrad4 append-only execution record",
  "type": "object",
  "required": [
    "record_type",
    "experiment_name",
    "git_commit",
    "run_id",
    "recorded_at",
    "eval_manifest_hash",
    "execution_binding_sha256",
    "runtime_binding_sha256",
    "current_binding_sha256",
    "record_index",
    "previous_record_sha256",
    "record_sha256"
  ],
  "properties": {
    "record_type": {
      "enum": [
        "s0_preflight",
        "smsb_capture",
        "smsb_replay",
        "smsb_adjudication",
        "tetrad_construct",
        "tetrad_replay",
        "tetrad_adjudication",
        "audit_result"
      ]
    },
    "experiment_name": {"const": "qwen25_7b_serialization_credit_pilots_seed2026"},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,31}$"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "eval_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_binding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_binding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "current_binding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "record_index": {"type": "integer", "minimum": 0},
    "previous_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {"type": "string"},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authoring_artifact": {"type": "string"},
    "authoring_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "parent_credential_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "parent_credential_mac": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "parent_credential_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "parent_credential_path": {"type": "string"},
    "parent_issuer_pid": {"type": "integer", "minimum": 1},
    "observed_parent_pid": {"type": "integer", "minimum": 1},
    "process_pid": {"type": "integer", "minimum": 1},
    "parent_authority_secret_path": {"type": "string"},
    "parent_authority_secret_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "parent_receipt_path": {"type": "string"},
    "parent_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "parent_receipt_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "parent_receipt_mac": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "parent_launcher_pid": {"type": "integer", "minimum": 1},
    "observed_child_ppid": {"type": "integer", "minimum": 1},
    "child_exit_code": {"const": 0},
    "child_stdout_artifact": {"type": "string"},
    "child_stdout_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pre_child_model_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "post_child_model_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "post_child_current_binding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pre_child_physical_gpu_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "post_child_physical_gpu_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "post_child_full_model_sha_verified": {"const": true},
    "status": {"enum": ["PASS", "FAIL"]},
    "decision": {"type": "string"},
    "example_id": {"type": "string"},
    "regime": {"enum": ["temperature_zero", "matched_seed", "independent_seed"]},
    "request_id": {"type": "string"},
    "state_role": {"enum": ["generated", "empty", "irrelevant", "shuffle", "gold"]},
    "training_authorized": {"const": false},
    "method_selection_status": {"const": "PENDING_EVIDENCE_NO_SELECTION"}
  },
  "allOf": [
    {
      "if": {"properties": {"record_type": {"const": "s0_preflight"}}},
      "then": {
        "required": [
          "parent_authority_secret_path",
          "parent_authority_secret_sha256"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "enum": ["smsb_capture", "smsb_replay", "tetrad_replay"]
          }
        }
      },
      "then": {
        "required": [
          "parent_credential_id",
          "parent_credential_mac",
          "parent_credential_sha256",
          "parent_credential_path",
          "process_pid",
          "parent_receipt_path",
          "parent_receipt_sha256",
          "parent_receipt_id",
          "parent_receipt_mac",
          "parent_launcher_pid",
          "observed_child_ppid",
          "child_exit_code",
          "child_stdout_artifact",
          "child_stdout_artifact_sha256",
          "pre_child_model_manifest_sha256",
          "post_child_model_manifest_sha256",
          "post_child_current_binding_sha256",
          "pre_child_physical_gpu_identity_sha256",
          "post_child_physical_gpu_identity_sha256",
          "post_child_full_model_sha_verified"
        ]
      }
    }
  ],
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TF-RWWPO transactional actual-loss record",
  "type": "object",
  "required": [
    "schema_version", "attempt_id", "mode", "objective_variant", "controller_variant",
    "global_step", "rank", "epoch", "minibatch", "old_log_prob", "current_log_prob",
    "proposed_post_log_prob", "committed_log_prob", "response_mask", "writer_mask",
    "answer_mask", "trajectory_turn", "sample_index", "example_identity_hash",
    "trajectory_identity_hash", "advantages", "denominator",
    "prefix_rows", "prefix_stats", "post_prefix_rows", "post_prefix_stats",
    "alpha_grid", "alpha_test_order", "alpha_committed", "accepted_nonzero",
    "proposal_zero", "trial_evidence", "full_parameter_displacement_norm",
    "committed_parameter_displacement_norm", "pre_digests", "commit_digests",
    "trial_forward_wall_seconds", "q_min", "writer_log_ratio_cap",
    "previous_record_sha256", "record_sha256"
  ],
  "properties": {
    "schema_version": {"const": "rwwpo-actual-loss-v2"},
    "objective_variant": {"enum": ["whole_prefix", "original_tokenwise"]},
    "controller_variant": {"const": "feasible_backtracking"},
    "alpha_grid": {"const": [1.0, 0.5, 0.25, 0.125, 0.0625, 0.03125]},
    "alpha_committed": {"enum": [0.0, 1.0, 0.5, 0.25, 0.125, 0.0625, 0.03125]},
    "q_min": {"const": 0.5},
    "accepted_nonzero": {"type": "boolean"},
    "proposal_zero": {"type": "boolean"},
    "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}

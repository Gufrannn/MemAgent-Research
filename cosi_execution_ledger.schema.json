{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memagent.cosi.ledger.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sequence", "previous_sha256", "payload", "record_sha256"],
  "properties": {
    "schema": {"const": "memagent.cosi.ledger.v1"},
    "sequence": {"type": "integer", "minimum": 0},
    "previous_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload": {"type": "object"},
    "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

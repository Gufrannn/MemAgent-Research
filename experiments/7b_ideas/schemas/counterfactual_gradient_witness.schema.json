{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"W4 v8 endpoint, policy-derivative, and geometry capture",
  "type":"object",
  "required":["schema_version","endpoint_mode","endpoint_parity_ledger","policy_derivative_mode","policy_gradient_scope_label","policy_node_ledger","direction_adjudication_requested","gradient_geometry_mode","actual_parameter_block_hash","reference_parameter_block_hash","raw_euclidean_cosine_role","raw_euclidean_cosine_parameterization_invariant","geometry_selected_after_endpoint","on_policy_same_checkpoint_candidates","candidate_groups_prefrozen","candidate_groups_independent","iid_candidates_within_group","candidate_group_manifest_hash","reader_seed_derivation","rng_advance_candidate_length_dependent","writer_token_mask_exact","writer_mask_includes_eos_or_stop","validity_frozen_before_return","truncation_frozen_before_return","row_selection_frozen_before_return","return_or_outcome_conditioned_selection","actual_group_reconstructable","actual_bonus_reconstructable","actual_logprob_reconstructable","loss_reconstruction_exact","single_batch_directional_evidence_authorized","algorithm_novelty_authorized","optimizer_steps","new_rollouts","evidence_basis","groups"],
  "properties":{
    "schema_version":{"const":"counterfactual-gradient-witness-v8"},
    "endpoint_mode":{"enum":["CV_same_endpoint","OM_distinct_endpoint"]},
    "endpoint_parity_ledger":{"type":"array","minItems":15,"maxItems":15,"items":{"$ref":"#/$defs/parity"}},
    "policy_derivative_mode":{"enum":["L_frozen_future_policy","T_tied_recurrent_policy"]},
    "policy_gradient_scope_label":{"enum":["frozen_future_local_writer_gradient","full_terminal_recurrent_policy_gradient","local_recurrent_semi_gradient"]},
    "policy_node_ledger":{"type":"array","minItems":4,"items":{"$ref":"#/$defs/node"}},
    "direction_adjudication_requested":{"type":"boolean"},
    "gradient_geometry_mode":{"enum":["none_no_direction_adjudication","Fisher_tested_subspace","optimizer_delivery"]},
    "actual_parameter_block_hash":{"$ref":"#/$defs/hash"},"reference_parameter_block_hash":{"$ref":"#/$defs/hash"},
    "raw_euclidean_cosine_role":{"const":"fixed_coordinate_secondary_diagnostic_only"},
    "raw_euclidean_cosine_parameterization_invariant":{"const":false},"geometry_selected_after_endpoint":{"const":false},
    "on_policy_same_checkpoint_candidates":{"const":true},
    "candidate_groups_prefrozen":{"const":true},"candidate_groups_independent":{"const":true},
    "iid_candidates_within_group":{"const":true},"candidate_group_manifest_hash":{"$ref":"#/$defs/hash"},
    "reader_seed_derivation":{"const":"pre_candidate_state_coupling_manifest"},
    "rng_advance_candidate_length_dependent":{"const":false},
    "writer_token_mask_exact":{"const":true},"writer_mask_includes_eos_or_stop":{"const":true},
    "validity_frozen_before_return":{"const":true},"truncation_frozen_before_return":{"const":true},
    "row_selection_frozen_before_return":{"const":true},"return_or_outcome_conditioned_selection":{"const":false},
    "actual_group_reconstructable":{"const":true},"actual_bonus_reconstructable":{"const":true},
    "actual_logprob_reconstructable":{"const":true},"loss_reconstruction_exact":{"const":true},
    "single_batch_directional_evidence_authorized":{"const":false},"algorithm_novelty_authorized":{"const":false},
    "optimizer_steps":{"const":0},"new_rollouts":{"const":false},
    "evidence_basis":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "groups":{"type":"array","minItems":4,"items":{"type":"object"}}
  },
  "$defs":{
    "hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "parity":{"type":"object","required":["dimension","training_definition_hash","scientific_definition_hash","same_definition"],"properties":{"dimension":{"enum":["horizon","future_policy","suffix_contract","reader","answer_cell","answer_normalization","reward_components","reward_weights","reward_scale","invalid_rule","truncation_rule","missing_rule","row_weights","candidate_joinability","score_mask_joinability"]},"training_definition_hash":{"$ref":"#/$defs/hash"},"scientific_definition_hash":{"$ref":"#/$defs/hash"},"same_definition":{"type":"boolean"}},"additionalProperties":false},
    "node":{"type":"object","required":["node_id","role","checkpoint_hash","parameter_identity_hash","shares_theta","semantics","token_span","includes_eos_or_stop","mask_hash","actual_included","reference_included","arm_parity","stopgrad"],"properties":{"node_id":{"type":"string","minLength":1},"role":{"enum":["current_writer","future_writer","future_answer","future_reader"]},"checkpoint_hash":{"$ref":"#/$defs/hash"},"parameter_identity_hash":{"$ref":"#/$defs/hash"},"shares_theta":{"type":"boolean"},"semantics":{"enum":["target_policy","frozen_environment"]},"token_span":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"integer","minimum":0}},"includes_eos_or_stop":{"type":"boolean"},"mask_hash":{"$ref":"#/$defs/hash"},"actual_included":{"type":"boolean"},"reference_included":{"type":"boolean"},"arm_parity":{"const":true},"stopgrad":{"type":"boolean"}},"additionalProperties":false}
  },
  "additionalProperties":true
}

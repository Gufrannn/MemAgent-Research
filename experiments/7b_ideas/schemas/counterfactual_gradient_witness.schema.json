{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"W4 counterfactual score-function gradient witness capture",
  "type":"object",
  "required":["schema_version","on_policy_same_checkpoint_candidate","exact_noop_v2_qualified","exact_noop_v2_manifest_hash","noop_baseline_candidate_independent","noop_rng_independent","noop_cache_independent","noop_coupling_frozen_before_candidate","noop_coupling_exogenous_given_state","factual_retain_shared_crn","reader_seed_derivation","rng_advance_candidate_length_dependent","coupling_plan_frozen_before_first_tau","seeds_added_after_first_tau","seed_selected_by_sign","reader_repeats_increase_independent_n","candidate_clustered_inference","coupling_mode","frozen_reader_coupling_ids","expected_couplings_per_candidate","writer_token_mask_exact","validity_frozen_before_tau","truncation_frozen_before_tau","row_selection_frozen_before_tau","tau_or_outcome_conditioned_selection","shared_suffix_endpoint_frozen","actual_group_reconstructable","actual_bonus_reconstructable","actual_logprob_reconstructable","actual_clip_reconstructable","actual_kl_reconstructable","same_loss_graph_decomposition","gradient_components_reconstructable","credit_uses_actual_group_advantage","credit_token_broadcast_exact","credit_clip_disabled","credit_regularizers_disabled","gradient_additivity_atol","optimizer_steps","new_rollouts","material_effect_threshold","evidence_basis","events"],
  "properties":{
    "schema_version":{"const":"counterfactual-gradient-witness-v4"},
    "on_policy_same_checkpoint_candidate":{"const":true},"exact_noop_v2_qualified":{"const":true},
    "exact_noop_v2_manifest_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "noop_baseline_candidate_independent":{"const":true},"noop_rng_independent":{"const":true},"noop_cache_independent":{"const":true},
    "noop_coupling_frozen_before_candidate":{"const":true},"noop_coupling_exogenous_given_state":{"const":true},
    "factual_retain_shared_crn":{"const":true},
    "reader_seed_derivation":{"const":"pre_candidate_state_coupling_manifest"},
    "rng_advance_candidate_length_dependent":{"const":false},
    "coupling_plan_frozen_before_first_tau":{"const":true},"seeds_added_after_first_tau":{"const":false},
    "seed_selected_by_sign":{"const":false},"reader_repeats_increase_independent_n":{"const":false},
    "candidate_clustered_inference":{"const":true},
    "coupling_mode":{"enum":["single_exogenous_crn","prefrozen_multiple_independent_crn"]},
    "frozen_reader_coupling_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "expected_couplings_per_candidate":{"type":"integer","minimum":1},
    "validity_frozen_before_tau":{"const":true},"truncation_frozen_before_tau":{"const":true},
    "row_selection_frozen_before_tau":{"const":true},"tau_or_outcome_conditioned_selection":{"const":false},
    "writer_token_mask_exact":{"const":true},"shared_suffix_endpoint_frozen":{"const":true},
    "actual_group_reconstructable":{"const":true},"actual_bonus_reconstructable":{"const":true},
    "actual_logprob_reconstructable":{"const":true},"actual_clip_reconstructable":{"const":true},"actual_kl_reconstructable":{"const":true},
    "same_loss_graph_decomposition":{"const":true},"gradient_components_reconstructable":{"const":true},
    "credit_uses_actual_group_advantage":{"const":true},"credit_token_broadcast_exact":{"const":true},
    "credit_clip_disabled":{"const":true},"credit_regularizers_disabled":{"const":true},
    "gradient_additivity_atol":{"const":1e-8},
    "optimizer_steps":{"const":0},"new_rollouts":{"const":false},
    "material_effect_threshold":{"type":"number","exclusiveMinimum":0},
    "evidence_basis":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "events":{"type":"array","minItems":4,"items":{"type":"object"}}
  },
  "additionalProperties":true
}

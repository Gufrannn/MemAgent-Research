{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"W4 v8 analysis-only report",
  "type":"object",
  "required":["status","endpoint_mode","endpoint_parity_complete","policy_derivative_mode","policy_gradient_scope_label","policy_node_ledger_complete","actual_reference_policy_node_sets_match","gradient_geometry_mode","geometry_claim","raw_euclidean_cosine_role","highest_claim_level","w4_claim_authorized","training_authorized","engineering_two_step_authorized","algorithm_novelty","independent_candidate_groups","single_batch_directional_evidence_authorized","prohibited_inferences"],
  "properties":{
    "status":{"enum":["W4_V8_PLUMBING_ONLY","W4_V8_SCIENTIFIC_AUDIT_READY"]},
    "endpoint_mode":{"enum":["CV_same_endpoint","OM_distinct_endpoint"]},
    "endpoint_parity_complete":{"const":true},
    "policy_derivative_mode":{"enum":["L_frozen_future_policy","T_tied_recurrent_policy"]},
    "policy_gradient_scope_label":{"enum":["frozen_future_local_writer_gradient","full_terminal_recurrent_policy_gradient","local_recurrent_semi_gradient"]},
    "policy_node_ledger_complete":{"const":true},
    "actual_reference_policy_node_sets_match":{"const":true},
    "gradient_geometry_mode":{"enum":["none_no_direction_adjudication","Fisher_tested_subspace","optimizer_delivery"]},
    "geometry_claim":{"enum":["none","empirical_Fisher_tested_subspace_geometry","optimizer_delivery_evidence"]},
    "raw_euclidean_cosine_role":{"const":"fixed_coordinate_secondary_diagnostic_only"},
    "highest_claim_level":{"const":"W3"},"w4_claim_authorized":{"const":false},
    "training_authorized":{"const":false},"engineering_two_step_authorized":{"const":false},
    "algorithm_novelty":{"const":false},"independent_candidate_groups":{"type":"integer","minimum":4},
    "single_batch_directional_evidence_authorized":{"const":false},
    "prohibited_inferences":{"type":"array","contains":{"const":"single_batch_alignment"}}
  },
  "additionalProperties":true
}
